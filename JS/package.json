{
  "name": "ant-colony-p5",
  "version": "1.0.0",
  "private": true,
  "description": "Ant colony simulation ported to p5.js with webpack bundling.",
  "scripts": {
    "build": "webpack --config webpack.config.js --mode production",
    "watch": "webpack --config webpack.config.js --mode development --watch",
    "dev": "webpack serve --config webpack.config.js --mode development --open",
    "start": "npm run dev"
  },
  "devDependencies": {
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "css-loader": "^6.9.1",
    "style-loader": "^3.3.4"
  },
  "dependencies": {
    "p5": "^1.9.0"
  }
}
